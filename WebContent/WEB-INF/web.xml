<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd" id="WebApp_ID" version="3.0">
  <display-name>ONAPRE_SISPRE_EJEC_WEBTier</display-name>
  <context-param>
    <param-name>org.jboss.jbossfaces.JSF_CONFIG_NAME</param-name>
    <param-value>Mojarra-2.1.7</param-value>
  </context-param>
  <context-param>
    <param-name>javax.faces.PARTIAL_STATE_SAVING</param-name>
    <param-value>false</param-value>
  </context-param>
  <context-param>
    <param-name>javax.faces.INTERPRET_EMPTY_STRING_SUBMITTED_VALUES_AS_NULL</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>primefaces.THEME</param-name>
    <param-value>redmond</param-value>
  </context-param>
  <servlet>
    <servlet-name>Faces Servlet</servlet-name>
    <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>Faces Servlet</servlet-name>
    <url-pattern>/faces/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>Faces Servlet</servlet-name>
    <url-pattern>*.jsf</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>Faces Servlet</servlet-name>
    <url-pattern>*.xhtml</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>faces/apps/seleccion/seleccion_ente.xhtml</welcome-file>
  </welcome-file-list>
  <error-page>
    <error-code>403</error-code>
    <location>/error/403.xhtml</location>
  </error-page>
  <security-constraint>
    <display-name>SISPRE EJECUCIÓN</display-name>
    <web-resource-collection>
      <web-resource-name>ONAPRE_SISPRE_EJEC_WEBTier</web-resource-name>
      <url-pattern>/apps/*</url-pattern>
      <url-pattern>/faces/apps/*</url-pattern>
      <url-pattern>/apps/menu/menu.xhtml</url-pattern>
      <url-pattern>/faces/apps/menu/menu.xhtml</url-pattern>
      <url-pattern>/apps/menu/cambio_clave.xhtml</url-pattern>
      <url-pattern>/faces/apps/menu/cambio_clave.xhtml</url-pattern>
      <url-pattern>/faces/seleccion/seleccion_ente.xhtml</url-pattern>
      <url-pattern>/apps/seleccion/seleccion_ente.xhtml</url-pattern>
      <http-method>GET</http-method>
      <http-method>POST</http-method>
      <http-method>PUT</http-method>
      <http-method>DELETE</http-method>
      <http-method>HEAD</http-method>
      <http-method>OPTIONS</http-method>
      <http-method>TRACE</http-method>
    </web-resource-collection>
    <auth-constraint>
      <role-name>ADMIN</role-name>
      <role-name>CONSULTA_EJEC_TIII</role-name>
      <role-name>EJECUCION_TIII_ENTE</role-name>
      <role-name>EJECUCION_TIII_ONAPRE</role-name>
      <role-name>ADMIN_USER_EJEC_TIII</role-name>      
    </auth-constraint>
  </security-constraint>    
  <security-role>
    <role-name>ADMIN</role-name>
  </security-role>
  <security-role>
    <role-name>CONSULTA_EJEC_TIII</role-name>
  </security-role>
  <security-role>
    <role-name>EJECUCION_TIII_ENTE</role-name>
  </security-role>
  <security-role>
    <role-name>EJECUCION_TIII_ONAPRE</role-name>
  </security-role>
  <security-role>
    <role-name>ADMIN_USER_EJEC_TIII</role-name>
  </security-role>  
  <session-config>
    <session-timeout>20</session-timeout>
  </session-config>
</web-app>